{
  "name": "@dolphincloud/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DolphinCloud secure Electron shell for the class terminal",
  "author": "Team Falcons",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "start": "electron .",
    "test": "vitest run src/__tests__"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.hy916.dolphincloud.classterminal",
    "productName": "海豚云班级端",
    "artifactName": "DolphinCloud-ClassTerminal-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "assets/app-icon.png",
      "src/**/*.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist/web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "executableName": "DolphinCloud-ClassTerminal",
      "icon": "assets/app-icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
