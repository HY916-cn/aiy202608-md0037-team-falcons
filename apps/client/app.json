{
  "expo": {
    "name": "DolphinCloud",
    "slug": "dolphin-cloud",
    "version": "0.1.0",
    "icon": "./assets/app-icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "dolphincloud",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon-32.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0067C0",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "package": "cn.hy916.dolphincloud",
      "versionCode": 1
    },
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "cn.hy916.dolphincloud",
      "supportsTablet": true
    }
  }
}
