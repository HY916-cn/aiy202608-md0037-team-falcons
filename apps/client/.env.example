# ==============================================================================
# DolphinCloud Web Production Environment Example
# ==============================================================================

# [REQUIRED] Supabase Configuration
# The base URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# [REQUIRED] Supabase Anon Key
# The anonymous public key for your Supabase project. DO NOT use the service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# [REQUIRED] Application Environment
# Should be set to 'production' for live deployments.
EXPO_PUBLIC_APP_ENV=production

# [REQUIRED] AI Gateway Function
# The name of the Edge Function deployed on Supabase that handles AI requests.
EXPO_PUBLIC_AI_GATEWAY_FUNCTION=ai-gateway

# ==============================================================================
# NOTE: Do NOT commit real secrets or tokens to this file.
# In production, ensure no mock data or demo roles are configured.
# ==============================================================================

